# Copy to .env.local and fill in. Never commit the real file.

# Public URL of the app, used for Stripe redirects and the PDF renderer.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key that bypasses RLS. Set one of the two.
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-jwt

# OpenAI
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BASIC_PRICE_ID=price_...
STANDARD_PRICE_ID=price_...
PROFESSIONAL_PRICE_ID=price_...
ULTIMATE_PRICE_ID=price_...

# Browserless (remote Chromium used to print CVs to PDF)
BROWSERLESS_API_KEY=your-browserless-token

# PostHog (optional analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
